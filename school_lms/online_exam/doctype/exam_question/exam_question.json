   "fieldname": "topic",
   "fieldtype": "Link",
   "label": "Topic",
   "options": "Topic",
   "in_standard_filter": 1
  },
  {
   "fieldname": "column_break_type",
   "fieldtype": "Column Break"
  },
  {
   "fieldname": "question_type",
   "fieldtype": "Select",
   "label": "Question Type",
   "options": "Single Choice (MCQ)\nMultiple Choice (MSQ)\nTrue / False\nFill in the Blank\nNumeric\nShort Answer\nLong Answer\nDrawing",
   "default": "Single Choice (MCQ)",
   "reqd": 1,
   "in_list_view": 1,
   "in_standard_filter": 1
  },
  {
   "fieldname": "difficulty",
   "fieldtype": "Select",
   "label": "Difficulty",
   "options": "\nEasy\nMedium\nHard",
   "in_standard_filter": 1
  },
  {
   "fieldname": "marks",
   "fieldtype": "Float",
   "label": "Marks",
   "default": "1",
   "reqd": 1,
   "non_negative": 1
  },
  {
   "fieldname": "negative_marks",
   "fieldtype": "Float",
   "label": "Negative Marks",
   "default": "0",
   "non_negative": 1,
   "depends_on": "eval:[\"Single Choice (MCQ)\", \"Multiple Choice (MSQ)\", \"True / False\", \"Fill in the Blank\", \"Numeric\"].includes(doc.question_type)",
   "description": "Deducted for a wrong answer. Unanswered questions are never penalised."
  },
  {
   "fieldname": "enabled",
   "fieldtype": "Check",
   "label": "Enabled",
   "default": "1"
  },
  {
   "fieldname": "section_question",
   "fieldtype": "Section Break",
   "label": "Question"
  },
  {
   "fieldname": "question",
   "fieldtype": "Text Editor",
   "label": "Question",
   "reqd": 1
  },
  {
   "fieldname": "question_image",
   "fieldtype": "Attach Image",
   "label": "Question Image",
   "description": "Optional diagram, map or picture shown with the question."
  },
  {
   "fieldname": "question_summary",
   "fieldtype": "Data",
   "label": "Summary",
   "read_only": 1,
   "hidden": 1,
   "length": 140
  },
  {
   "fieldname": "section_options",
   "fieldtype": "Section Break",
   "label": "Options",
   "depends_on": "eval:[\"Single Choice (MCQ)\", \"Multiple Choice (MSQ)\", \"True / False\"].includes(doc.question_type)"
  },
  {
   "fieldname": "options",
   "fieldtype": "Table",
   "label": "Options",
   "options": "Exam Question Option",
   "description": "Tick Correct for the right option. Multiple Choice (MSQ) can have more than one correct option; the student must pick all of them."
  },
  {
   "fieldname": "section_answer",
   "fieldtype": "Section Break",
   "label": "Correct Answer",
   "depends_on": "eval:[\"Fill in the Blank\", \"Numeric\"].includes(doc.question_type)"
  },
  {
   "fieldname": "accepted_answers",
   "fieldtype": "Small Text",
   "label": "Accepted Answers",
   "description": "One accepted answer per line. Matching ignores capital letters and extra spaces."
  },
  {
   "fieldname": "numeric_tolerance",
   "fieldtype": "Float",
   "label": "Allowed Difference",
   "depends_on": "eval:doc.question_type==\"Numeric\"",
   "description": "For example 0.01 accepts 3.14 when the answer is 3.141"
  },
  {
   "fieldname": "section_subjective",
   "fieldtype": "Section Break",
   "label": "Subjective Answer",
   "depends_on": "eval:[\"Short Answer\", \"Long Answer\", \"Drawing\"].includes(doc.question_type)"
  },
  {
   "fieldname": "answer_word_limit",
   "fieldtype": "Int",
   "label": "Word Limit",
   "depends_on": "eval:[\"Short Answer\", \"Long Answer\"].includes(doc.question_type)",
   "description": "Shown to the student as a guide. 0 = no limit."
  },
  {
   "fieldname": "drawing_background",
   "fieldtype": "Attach Image",
   "label": "Drawing Background",
   "depends_on": "eval:doc.question_type==\"Drawing\"",
   "description": "Optional image the student draws on, e.g. an outline map or an unlabelled diagram."
  },
  {
   "fieldname": "model_answer",
   "fieldtype": "Text Editor",
   "label": "Model Answer / Marking Guide",
   "description": "Visible only to teachers while evaluating."
  }
 ],
